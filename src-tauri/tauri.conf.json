{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BitChord Lite",
  "version": "0.1.0",
  "identifier": "in.sigidpam.bitchordlite",
  "build": {
    "beforeDevCommand": "VITE_BITCHORD_NATIVE=1 corepack pnpm --dir web/app dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "VITE_BITCHORD_NATIVE=1 corepack pnpm --dir web/app build",
    "frontendDist": "../web/app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BitChord Lite",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
